# Copy these into Vercel → Project Settings → Environment Variables.
# The VITE_ ones are public (safe in the browser bundle).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side (never exposed to the browser).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Only needed for admin/service operations.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — only used by Lovable-managed cron/webhook endpoints.
# If you run cron jobs on Vercel, set this to a strong random secret and
# send it as the Authorization header.
LOVABLE_CRON_SECRET=
