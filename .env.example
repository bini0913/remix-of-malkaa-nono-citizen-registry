# Copy these values from your local .env file (or the Lovable editor backend settings)
# into Vercel → Project → Settings → Environment Variables.
#
# IMPORTANT: Vercel builds do NOT read this file. .env is gitignored, so you must
# paste every value into the Vercel dashboard for Production (and Preview if desired).
#
# The VITE_* variables are replaced into the browser bundle at build time.
# The non-VITE variables are read by server functions at runtime.

# Public (bundled into the browser by Vite)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Server-side (never exposed to the browser)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_PROJECT_ID=<project-ref>

# Only needed for admin/service operations (e.g. server-side privileged reads)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Optional — only used by Lovable-managed cron/webhook endpoints.
# If you run cron jobs on Vercel, set this to a strong random secret and
# send it as the Authorization header.
LOVABLE_CRON_SECRET=
